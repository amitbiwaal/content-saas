{
  "name": "contentos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ContentOS AI v2 — Content Intelligence Operating System (ADR-016 greenfield)",
  "engines": {
    "node": "22.x",
    "pnpm": "9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "setup": "node scripts/dev/run.mjs bootstrap",
    "dev": "node scripts/dev/run.mjs start",
    "dev:up": "node scripts/dev/run.mjs start",
    "dev:down": "node scripts/dev/run.mjs stop",
    "db:migrate": "node scripts/dev/run.mjs migrate",
    "db:reset": "node scripts/dev/run.mjs reset",
    "db:seed": "node scripts/dev/run.mjs seed",
    "db:verify-rls": "node scripts/dev/run.mjs verify-rls",
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "boundaries": "depcruise services packages workers --config .dependency-cruiser.cjs",
    "unused": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm unused && pnpm format && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "2.1.8",
    "dependency-cruiser": "16.9.0",
    "eslint": "9.17.0",
    "knip": "5.41.1",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vitest": "2.1.8"
  }
}
