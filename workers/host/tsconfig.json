{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@contentos/contracts": ["./packages/contracts/src/index.ts"],
      "@contentos/events": ["./packages/events/src/index.ts"],
      "@contentos/platform": ["./packages/platform/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist"],
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/events"
    },
    {
      "path": "../../packages/platform"
    }
  ]
}
