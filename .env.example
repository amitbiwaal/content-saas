# ContentOS v2 — local development template.
#
# Copy to `.env` (git-ignored) and adjust. `.env` is loaded ONLY in local
# development: a deployed process that reads a .env file will eventually read
# one left in an image (`07-development-guide/configuration.md`).
#
# NO REAL VALUE BELONGS IN THIS FILE. Every entry below is either a local
# container default or a placeholder. A committed-secret scan gates every commit
# and every push, and it runs over history as well as the working tree.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=contentos-api
SERVICE_VERSION=0.0.0-local
PORT=3001

# ── PostgreSQL 17 ───────────────────────────────────────────────────────────
# The application connects as the RLS-enforced role. It is NOT the table owner:
# a table's owner bypasses RLS unless FORCE is set, so ownership stays with the
# migrator (16-security/row-level-security.md).
DATABASE_URL=postgresql://contentos_app_login:contentos_dev_app@localhost:5432/contentos

# Migrations connect as the owner. Used only by scripts/db/*.
MIGRATOR_DATABASE_URL=postgresql://contentos_migrator_login:contentos_dev_migrator@localhost:5432/contentos

# Transaction pooling is REQUIRED. Statement pooling is prohibited outright —
# SET LOCAL and the query it protects could land on different connections,
# leaving RLS unenforced.
DB_POOL_MODE=transaction
DB_POOL_MAX=10

# ── Redis 7 ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO locally, R2 in production) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=contentos
S3_SECRET_ACCESS_KEY=contentos_dev_minio
S3_BUCKET_MEDIA=contentos-media
S3_BUCKET_EXPORTS=contentos-exports
S3_FORCE_PATH_STYLE=true

# ── Mail (Mailpit locally) ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@contentos.local

# ── Upload scanning ─────────────────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Secrets — PLACEHOLDERS ONLY ─────────────────────────────────────────────
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In every deployed environment these come from the secret store and are
# rotated on schedule. They are never read from a file.
AUTH_SECRET=replace-me-with-a-32-byte-random-value
CSRF_SECRET=replace-me-with-a-32-byte-random-value

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
