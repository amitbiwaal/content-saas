# Copy to .env.local for local dev. Everything here is optional.

# Where the browser reaches the backend for the live run stream. Dev only: the
# EventSource (SSE) connects straight to the backend so the Next rewrite proxy
# does not buffer the stream. In prod the BFF route handler serves it instead.
NEXT_PUBLIC_STREAM_ORIGIN=http://127.0.0.1:8000

# --- Google Sign-In (optional) ---
# Turns on the "Continue with Google" button on /login and /signup — with it
# unset the button simply does not render and only email/password is offered.
# Use the SAME OAuth 2.0 Client ID you set as GOOGLE_CLIENT_ID on the backend
# (the backend verifies the ID token this button returns). Create one at
# https://console.cloud.google.com/apis/credentials — type "Web application",
# with your origin (e.g. http://localhost:3000) under "Authorized JavaScript
# origins". The value is public by design; it is not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Prod only ---
# Backend origin the server-side BFF routes proxy to, and the shared API key
# they inject as X-API-Key (must match the backend's API_KEY).
# BACKEND_ORIGIN=
# API_KEY=
