# Dependency policy — `07-development-guide/dependency-management.md`
# `17-implementation/repository-structure.md` rules 8 and 11.

# Lifecycle scripts are disabled from the first install. The allowlist starts
# empty; adding the control after dependencies accumulate means auditing every
# existing postinstall.
ignore-scripts=true

# Strict, non-flat node_modules — a package may import only what it declares.
node-linker=isolated
hoist=false
shamefully-hoist=false
strict-peer-dependencies=true

# Exact versions only. No ranges anywhere (rule 11).
save-exact=true
save-prefix=

# Reproducible CI installs.
prefer-frozen-lockfile=true
resolution-mode=highest
auto-install-peers=false
engine-strict=true
