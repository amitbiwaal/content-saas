# --- Database ---
# Local dev defaults to SQLite (file in backend/). For prod use Postgres. You can
# paste a host's URL verbatim — a plain postgres:// or postgresql:// is auto-
# rewritten to postgresql+psycopg:// (the psycopg3 driver), so Railway/Render/
# Neon/Supabase connection strings work as-is.
# DATABASE_URL=postgresql://user:pass@host:5432/contentos
DATABASE_URL=sqlite:///./contentos.db

# --- App ---
APP_ENV=dev
# Frontend origin(s) allowed for CORS (the SSE stream connects here directly).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated Host allow-list enforced in prod (blank => any host in dev).
ALLOWED_HOSTS=
LOG_LEVEL=INFO

# --- Auth (opt-in) ---
# Blank => API is open (local dev). Set a strong secret to require the
# X-API-Key header on every route (REQUIRED when APP_ENV=prod). The frontend
# BFF forwards it server-side (set API_KEY there too).
API_KEY=

# --- User auth (JWT + Google Sign-In) ---
# Signs user JWTs. REQUIRED when APP_ENV=prod; blank falls back to a dev-only
# secret that is fine locally and unsafe in prod.
JWT_SECRET=
# Turns on "Continue with Google" on /login and /signup. Create an OAuth 2.0
# Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, add your site to
# "Authorized JavaScript origins" (e.g. http://localhost:3000), then put the
# SAME client id here and in the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Blank => the Google button is hidden and only email/password is offered.
GOOGLE_CLIENT_ID=

# --- Admin panel ---
# Comma-separated emails that get admin access (the /admin panel + /api/admin).
# This bootstraps the first admin without touching the DB; once in, an admin can
# promote others from the panel (which sets User.is_admin). Blank => no admins.
ADMIN_EMAILS=

# --- Rate limiting (in-process, per user/IP, per minute; 0 disables a bucket) ---
# Guards the billed pipeline/model POSTs and login/signup brute-force. Effective
# at single-worker scale; behind multiple workers, also enforce at the gateway.
RATE_LIMIT_RUN_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=12

# --- Provider transport ---
PROVIDER_TIMEOUT_S=60
PROVIDER_MAX_RETRIES=1

# --- Provider API keys (supply only what you have; missing keys fall back to mock) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# --- Model overrides (optional; defaults live in app/providers/registry.py) ---
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=
# GOOGLE_MODEL=
# XAI_MODEL=

# --- Featured-image generation (OpenAI images API) ---
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Cost & budget (cents; PRD §13) ---
# MONTHLY_BUDGET_CENTS=50000
# PER_ARTICLE_CEILING_CENTS=2000

# --- Research provider: hybrid | duckduckgo | brave | ahrefs | mock ---
# hybrid     => FREE DuckDuckGo first; if it's rate-limited, falls back to real web
#               search on your EXISTING OpenAI (gpt-4o-search-preview) / xAI (Grok
#               Live Search) key — no new signup/card. Reliable deep research.
# duckduckgo => real web search, FREE (no key/card/signup) — scrapes DuckDuckGo's
#               HTML results. Best-effort (can rate-limit); great zero-cost default.
# brave      => real web search (Brave Web Search API) with favicons. Get a key
#               at https://api-dashboard.search.brave.com and set BRAVE_API_KEY.
# ahrefs     => SEO keyword volume/difficulty overlay (needs AHREFS_API_KEY).
# mock       => deterministic, no network.
RESEARCH_PROVIDER=duckduckgo
AHREFS_API_KEY=
BRAVE_API_KEY=

# --- Integrations (PRD §15; blank => dry-run / mock) ---
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
GOOGLE_OAUTH_TOKEN=

# --- Social distribution (PRD §15; blank => dry run) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
REDDIT_ACCESS_TOKEN=
# REDDIT_USER_AGENT=ContentOS/1.0
REDDIT_DEFAULT_SUBREDDIT=
