# Local, non-secret configuration. NO SECRETS EVER APPEAR IN infrastructure/
# (07-development-guide/project-structure.md rule 13, enforced by a scan).
#
# Values here are development defaults for containers that only listen on
# localhost. Real values come from the secret store at runtime.

NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=contentos-api
SERVICE_VERSION=0.0.0-local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contentos

REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=contentos-media
S3_BUCKET_EXPORTS=contentos-exports

SMTP_HOST=localhost
SMTP_PORT=1025

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Transaction pooling is required; statement pooling is prohibited.
DB_POOL_MODE=transaction
