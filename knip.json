{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["tests/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["app/**/*.tsx", "next.config.mjs"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "ignore": ["backend/**", "frontend/**", "archive/**", "contentos-docs/**"],
  "ignoreFiles": [".dependency-cruiser.cjs", "packages/*/drizzle.config.ts"],
  "//": "`tests/` is a conformance suite, not a workspace package, so it declares no dependencies of its own; the packages it wires together are listed here.",
  "ignoreDependencies": [
    "@contentos/api",
    "@contentos/contracts",
    "@contentos/database",
    "@contentos/events",
    "@contentos/platform",
    "@contentos/security",
    "@contentos/worker-host"
  ]
}
